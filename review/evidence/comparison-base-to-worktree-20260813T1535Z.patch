+            "nana/build/output.lib",
+            "libpng/x64/output.lib",
+            "libjpeg-turbo-3.1.2/out/build/output.lib",
+            ".vs/index.db",
+            "x64/Release/ytdlp-interface.exe",
+            "Debug/ytdlp-interface.pdb",
