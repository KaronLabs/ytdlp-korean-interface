++def recovered_catalog_path():
++    value = os.environ.get("RECOVERED_CATALOG")
++    if not value:
++        raise AssertionError("RECOVERED_CATALOG must name the recovered catalog")
++    return (REPOSITORY_ROOT / value).resolve()
